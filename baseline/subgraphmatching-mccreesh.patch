diff -ruN -x 'build*' -x '*.o' -x .git SubgraphMatchingSurvey/vlabel/matching/EvaluateQuery.cpp SubgraphMatchingSurvey-mccreesh/vlabel/matching/EvaluateQuery.cpp
--- SubgraphMatchingSurvey/vlabel/matching/EvaluateQuery.cpp	2026-09-20 23:26:53.000000000 +0100

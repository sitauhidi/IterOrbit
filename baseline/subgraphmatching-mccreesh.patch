@@ -2684,6 +2684,19 @@
         std::cout << order[i] << ',';
     }
     std::cout << std::endl;
+    // [oex McCreesh patch] A query edge whose candidate relation is empty admits no embedding.
+    // The original code went on to convert_to_encoded_relation(), whose assert(edge_size > 0)
+    // aborted the process on exactly these instances instead of reporting 0 embeddings.
+    for (ui u = 0; u < query_graph->getVerticesCount(); ++u) {
+        ui nbr_cnt;
+        const VertexID* nbrs = query_graph->getVertexNeighbors(u, nbr_cnt);
+        for (ui j = 0; j < nbr_cnt; ++j) {
+            if (u < nbrs[j] && storage->edge_relations_[u][nbrs[j]].size_ == 0) {
+                std::cout << "empty edge relation (" << u << "," << nbrs[j] << "): 0 embeddings" << std::endl;
+                return 0;
+            }
+        }
+    }
     convert_to_encoded_relation(storage, order);
 #ifdef SPARSE_BITMAP
     convert_encoded_relation_to_sparse_bitmap(storage, order);
